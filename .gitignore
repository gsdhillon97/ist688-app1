# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environment (uv recreates it from pyproject.toml and uv.lock)
.venv/
venv/
env/

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Environment and secrets — never commit these
.env
.streamlit/secrets.toml

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
